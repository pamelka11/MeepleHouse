<Window x:Class="MeepleHouse.Games.CarcassonneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каркассон"
        Height="670"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="RegisterButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="210"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="23">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  ShadowDepth="3"
                                                  Opacity="0.22"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="0,0,0,137">

        <Grid.RowDefinitions>
            <RowDefinition Height="125"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя шапка -->
        <Grid Grid.Row="0">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.6"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="🎲  ♟  🧩  🎴"
                       FontSize="42"
                       Opacity="0.08"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 35 0"/>

            <StackPanel VerticalAlignment="Center"
                        Margin="35 0 0 0">

                <TextBlock Text="Каркассон"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Стратегическая настольная игра"
                           FontSize="15"
                           Foreground="#B9DEB5"
                           Margin="2 4 0 0"/>

            </StackPanel>

        </Grid>

        <!-- Основная карточка -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="22"
                Margin="35,20,35,-110"
                Padding="22">

            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  ShadowDepth="4"
                                  Opacity="0.16"/>
            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Картинка -->
                <Border Grid.Column="0"
                        CornerRadius="18"
                        ClipToBounds="True"
                        Height="285"
                        VerticalAlignment="Top">

                    <Image Source="Image/carcassonne.png"
                           Stretch="UniformToFill"/>

                </Border>

                <!-- Информация -->
                <Grid Grid.Column="1"
                      Margin="28 0 0 0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="Описание"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#263238"
                                   Margin="0 0 0 5"/>

                        <TextBlock Text="Стратегическая игра про строительство средневековых земель."
                                   FontSize="14"
                                   Foreground="#455A64"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0 0 0 10"/>

                        <!-- Краткие правила -->
                        <Border Background="#EAF4EE"
                                CornerRadius="14"
                                Padding="13"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Краткие правила"
                                           FontSize="13"
                                           Foreground="#607D8B"/>

                                <TextBlock Text="Игроки по очереди выкладывают тайлы местности, строят города, дороги и монастыри. Очки начисляются за завершённые объекты и размещённых подданных."
                                           FontSize="14"
                                           Foreground="#355347"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Margin="0 4 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- Ближайшая игра -->
                        <Border Background="#F1F8F3"
                                CornerRadius="14"
                                Padding="13"
                                Height="66"
                                Margin="0 0 0 10">

                            <StackPanel>

                                <TextBlock Text="Ближайшая игра"
                                           FontSize="13"
                                           Foreground="#607D8B"/>

                                <TextBlock x:Name="DateText"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#1B6B32"
                                           Margin="0 3 0 0"/>

                            </StackPanel>

                        </Border>

                        <!-- Участники -->
                        <Border Background="#F1F8F3"
                                CornerRadius="14"
                                Padding="13"
                                Height="66">

                            <StackPanel>

                                <TextBlock Text="Количество участников"
                                           FontSize="13"
                                           Foreground="#607D8B"/>

                                <TextBlock x:Name="PlayersText"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1B6B32"
                                           Margin="0 3 0 0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                    <!-- Кнопка -->
                    <Button Grid.Row="1"
                            Content="Записаться"
                            Style="{StaticResource RegisterButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Click="Register_Click"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</Window>