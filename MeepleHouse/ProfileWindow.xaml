<Window x:Class="MeepleHouse.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль"
        Height="796"
        Width="430"
        WindowStartupLocation="CenterScreen"
        Background="#EEF5EE"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F1F8F2" Offset="0"/>
                <GradientStop Color="#FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ШАПКА -->
        <Border Height="150"
                VerticalAlignment="Top"
                Background="#0B6B2B">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Meeple House"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Кружок настольных игр"
                           FontSize="13"
                           Foreground="#D8F5DD"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- КАРТОЧКА ПРОФИЛЯ -->
        <Border Width="340"
                Padding="30"
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,115,0,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Opacity="0.22"/>
            </Border.Effect>

            <StackPanel>

                <!-- ИКОНКА -->
                <Border Width="90"
                        Height="90"
                        CornerRadius="45"
                        Background="#C8E6C9"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15">

                    <TextBlock Text="👤"
                               FontSize="42"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Профиль"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- ДАННЫЕ -->
                <TextBlock Text="ФИО"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <Border Background="#F4F7F5"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,5,0,15">

                    <TextBlock x:Name="NameText"
                               FontSize="16"
                               Foreground="#263238"/>
                </Border>

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <Border Background="#F4F7F5"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,5,0,15">

                    <TextBlock x:Name="EmailText"
                               FontSize="16"
                               Foreground="#263238"/>
                </Border>

                <TextBlock Text="Телефон"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <Border Background="#F4F7F5"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,5,0,25">

                    <TextBlock x:Name="PhoneText"
                               FontSize="16"
                               Foreground="#263238"/>
                </Border>

                <!-- КНОПКИ -->
                <Button Content="Мои записи"
                        Background="#0B7A34"
                        Margin="0,0,0,12"
                        Click="MyRegistrations_Click"
                        Style="{StaticResource RoundedButtonStyle}"/>

                <Button Content="Редактировать профиль"
                        Background="#198C43"
                        Margin="0,0,0,12"
                        Click="Edit_Click"
                        Style="{StaticResource RoundedButtonStyle}"/>

                <Button Content="Выйти"
                        Background="#E53935"
                        Click="Logout_Click"
                        Style="{StaticResource RoundedButtonStyle}"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>