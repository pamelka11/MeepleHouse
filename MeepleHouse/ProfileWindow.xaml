<Window x:Class="MeepleHouse.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль"
        Height="796"
        Width="430"
        WindowStartupLocation="CenterScreen"
        Background="#EEF5EE"
        ResizeMode="NoResize">

    <Grid Margin="0,0,0,150">

        <!-- ФОН -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8F5E9" Offset="0"/>
                <GradientStop Color="#F5FFF5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- ШАПКА -->
        <Border Height="90"
                VerticalAlignment="Top"
                Background="#43A047"
                CornerRadius="0,0,25,25">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Meeple House"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Кружок настольных игр"
                           FontSize="13"
                           Foreground="#E8F5E9"
                           HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

        <!-- КАРТОЧКА ПРОФИЛЯ -->
        <Border Width="340"
                Padding="30"
                CornerRadius="20"
                Background="White"
                HorizontalAlignment="Center" Margin="0,95,0,-140">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="3"
                                  Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>

                <!-- ИКОНКА -->
                <Border Width="90"
                        Height="90"
                        CornerRadius="45"
                        Background="#C8E6C9"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 15">

                    <TextBlock Text="👤"
                               FontSize="42"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock Text="Профиль"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#2E7D32"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25" Height="36"/>

                <!-- ДАННЫЕ -->

                <TextBlock Text="ФИО"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <Border Background="#F7F7F7"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0 5 0 15">

                    <TextBlock x:Name="NameText"
                               FontSize="16"/>
                </Border>

                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <Border Background="#F7F7F7"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0 5 0 15">

                    <TextBlock x:Name="EmailText"
                               FontSize="16"/>
                </Border>

                <TextBlock Text="Телефон"
                           FontWeight="SemiBold"
                           Foreground="#555"/>

                <Border Background="#F7F7F7"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0 5 0 25">

                    <TextBlock x:Name="PhoneText"
                               FontSize="16"/>
                </Border>

                <!-- КНОПКИ -->

                <Button Content="Мои записи"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0 0 0 10"
                        Click="MyRegistrations_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                </Button>

                <Button Content="Редактировать профиль"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#66BB6A"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0 0 0 10"
                        Click="Edit_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                </Button>

                <Button Content="Выйти"
                        Height="42"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#E53935"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Logout_Click">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

        </Border>

    </Grid>
</Window>