<Window x:Class="MeepleHouse.AddStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление сотрудника"
        Height="871"
        Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Opacity="0.18"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D7DEE3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D7DEE3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D7DEE3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="125"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.6"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="👤  🔐  🧩"
                       FontSize="40"
                       Opacity="0.08"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 28 0"/>

            <StackPanel VerticalAlignment="Center"
                        Margin="32 0 0 0">

                <TextBlock Text="Добавление"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Создание учётной записи"
                           FontSize="15"
                           Foreground="#B9DEB5"
                           Margin="2 4 0 0"/>

            </StackPanel>
        </Grid>

        <!-- ФОРМА -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="24"
                Margin="32 -20 32 28"
                Padding="30">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.16"/>
            </Border.Effect>

            <StackPanel>

                <TextBlock Text="Новая учётная запись"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#263238"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 18"/>

                <TextBlock Text="Роль"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <ComboBox x:Name="RoleComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          Margin="0 0 0 12">
                    <ComboBoxItem Content="Сотрудник"/>
                    <ComboBoxItem Content="Администратор"/>
                </ComboBox>

                <TextBlock Text="Логин"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 12"/>

                <TextBlock Text="Пароль"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource ModernPasswordBoxStyle}"
                             Margin="0 0 0 12"/>

                <TextBlock Text="ФИО"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="FullNameBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 12"/>

                <TextBlock Text="Почта"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="EmailBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 12"/>

                <TextBlock Text="Телефон"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="PhoneBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 20"/>

                <Button Content="Добавить"
                        Style="{StaticResource MainButtonStyle}"
                        Click="Save_Click"/>

                <Button Content="Отмена"
                        Style="{StaticResource SecondButtonStyle}"
                        Margin="0 12 0 0"
                        Click="Cancel_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>