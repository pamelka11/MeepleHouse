<Window x:Class="MeepleHouse.MyRegistrationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои записи"
        Height="540"
        Width="640"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="23">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Opacity="0.18"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.6"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="🎲  📋  🧩"
                       FontSize="42"
                       Opacity="0.08"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 35 0"/>

            <StackPanel VerticalAlignment="Center"
                        Margin="35 0 0 0">
                <TextBlock Text="Мои записи"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Список выбранных игр"
                           FontSize="15"
                           Foreground="#B9DEB5"
                           Margin="2 4 0 0"/>
            </StackPanel>
        </Grid>

        <!-- КАРТОЧКА -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="24"
                Margin="35,-20,35,35"
                Padding="26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- СПИСОК -->
                <ListBox x:Name="RegistrationsList"
                         Grid.Row="0"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16"
                                    Margin="0 0 0 12"
                                    Background="#F1F8F3"
                                    CornerRadius="16">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="42"
                                                Height="42"
                                                CornerRadius="21"
                                                Background="#E5F3E8"
                                                Margin="0 0 14 0">
                                            <TextBlock Text="🎲"
                                                       FontSize="21"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GameName}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#263238"/>

                                            <TextBlock Text="Запись на игру"
                                                       FontSize="12"
                                                       Foreground="#607D8B"
                                                       Margin="0 3 0 0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="White"
                                            CornerRadius="12"
                                            Padding="12 8"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GameDate}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1B6B32"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- КНОПКА -->
                <Button Grid.Row="1"
                        Content="Отменить запись"
                        Style="{StaticResource CancelButtonStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Click="Cancel_Click"/>

            </Grid>
        </Border>
    </Grid>
</Window>