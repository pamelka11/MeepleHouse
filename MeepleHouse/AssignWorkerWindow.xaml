<Window x:Class="MeepleHouse.AssignWorkerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначение сотрудника"
        Height="616"
        Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9F8"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Opacity="0.18"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10 0"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D7DEE3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.6"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="♟  🎲  🧩"
                       FontSize="40"
                       Opacity="0.08"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 28 0"/>

            <StackPanel VerticalAlignment="Center"
                        Margin="32 0 0 0">

                <TextBlock Text="Назначение"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Выбор сотрудника и игры"
                           FontSize="15"
                           Foreground="#B9DEB5"
                           Margin="2 4 0 0"/>

            </StackPanel>
        </Grid>

        <!-- ФОРМА -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="24"
                Margin="32 -24 32 30"
                Padding="30">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.16"/>
            </Border.Effect>

            <StackPanel Margin="0,0,0,-20">

                <TextBlock Text="Назначить сотрудника на игру"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#263238"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 28"/>

                <TextBlock Text="Сотрудник"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 7"/>

                <ComboBox x:Name="WorkerComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0 0 0 20"/>

                <TextBlock Text="Игра"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 7"/>

                <ComboBox x:Name="GameComboBox"
                          Style="{StaticResource ModernComboBoxStyle}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0 0 0 32"/>
                <Button Content="Назначить"
                        Style="{StaticResource MainButtonStyle}"
                        Click="Assign_Click"/>

                <Button Content="Отмена"
                        Style="{StaticResource SecondButtonStyle}"
                        Margin="0 12 0 0"
                        Click="Cancel_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>