<Window x:Class="MeepleHouse.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование профиля"
        Height="806"
        Width="470"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Кнопка сохранить -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="23">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="3"
                                                  Opacity="0.18"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка отмены -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="23">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль textbox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D7DEE3"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="140"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.6"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="🎲  👤  🧩"
                       FontSize="42"
                       Opacity="0.08"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 25 0"/>

            <StackPanel VerticalAlignment="Center"
                        Margin="30 0 0 0">

                <TextBlock Text="Meeple House"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Редактирование профиля"
                           FontSize="15"
                           Foreground="#B9DEB5"
                           Margin="2 4 0 0"/>

            </StackPanel>

        </Grid>

        <!-- КАРТОЧКА -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="24"
                Margin="30,-20,30,30"
                Padding="30">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.16"/>
            </Border.Effect>

            <StackPanel>

                <!-- Аватар -->
                <Border Width="90"
                        Height="90"
                        CornerRadius="45"
                        Background="#E8F5E9"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 20">

                    <TextBlock Text="👤"
                               FontSize="42"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <TextBlock Text="Редактирование данных"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#263238"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="NameBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 18"/>

                <!-- EMAIL -->
                <TextBlock Text="Email"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="EmailBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 18"/>

                <!-- ТЕЛЕФОН -->
                <TextBlock Text="Телефон"
                           FontSize="14"
                           Foreground="#607D8B"
                           Margin="4 0 0 6"/>

                <TextBox x:Name="PhoneBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 32"/>

                <!-- КНОПКИ -->
                <Button Content="Сохранить"
                        Style="{StaticResource SaveButtonStyle}"
                        Click="Save_Click"/>

                <Button Content="Отмена"
                        Style="{StaticResource CancelButtonStyle}"
                        Margin="0 12 0 0"
                        Click="Cancel_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>