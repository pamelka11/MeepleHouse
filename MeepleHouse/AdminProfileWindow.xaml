<Window x:Class="MeepleHouse.AdminProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль администратора"
        Height="749"
        Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9F8"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>

        <Style x:Key="MainButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Button" BasedOn="{StaticResource MainButtonStyle}">
            <Setter Property="Background" Value="#EF3B3B"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Background" Value="#F4F7F6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="0,0,0,45">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.6"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Meeple House"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Панель администратора"
                           FontSize="14"
                           Foreground="#B9DEB5"
                           HorizontalAlignment="Center"
                           Margin="0 6 0 0"/>

            </StackPanel>
        </Grid>

        <!-- КАРТОЧКА ПРОФИЛЯ -->
        <Border Grid.RowSpan="2"
                Background="White"
                CornerRadius="22"
                Margin="55,122,55,-25"
                Padding="25">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.16"/>
            </Border.Effect>

            <StackPanel>

                <Border Width="90"
                        Height="90"
                        CornerRadius="45"
                        Background="#E8F5E9"
                        HorizontalAlignment="Center"
                        Margin="0 0 0 18">

                    <TextBlock Text="👤"
                               FontSize="42"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Профиль"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1B6B32"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 24"/>

                <TextBlock Text="ФИО"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#607D8B"
                           Margin="0 0 0 6"/>

                <TextBox x:Name="FullNameBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Email"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#607D8B"
                           Margin="0 0 0 6"/>

                <TextBox x:Name="EmailBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 14"/>

                <TextBlock Text="Телефон"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#607D8B"
                           Margin="0 0 0 6"/>

                <TextBox x:Name="PhoneBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0 0 0 24"/>

                <Button Content="Редактировать профиль"
                        Style="{StaticResource MainButtonStyle}"
                        Margin="0 0 0 12"
                        Click="EditProfile_Click"/>

                <Button Content="Выйти"
                        Style="{StaticResource ExitButtonStyle}"
                        Click="Logout_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>