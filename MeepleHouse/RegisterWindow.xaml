<Window x:Class="MeepleHouse.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="918"
        Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#EEF5EE"
        ResizeMode="NoResize">

    <!-- СТИЛЬ КНОПОК -->
    <Window.Resources>

        <Style x:Key="RoundedButton" TargetType="Button">

            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="18">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Border Background="#0F6B2E"
                Grid.Row="0">

            <StackPanel VerticalAlignment="Center"
                        Margin="30,0,0,20">

                <TextBlock Text="Meeple House"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Создание аккаунта"
                           FontSize="14"
                           Foreground="#C8E6C9"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Border>

        <!-- КАРТОЧКА -->
        <Border Grid.RowSpan="2"
                Width="345"
                Background="White"
                CornerRadius="22"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,135,0,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="3"
                                  Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>

                <!-- ИКОНКА -->
                <Border Width="90"
                        Height="90"
                        CornerRadius="45"
                        Background="#E8F5E9"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                    <TextBlock Text="👤"
                               FontSize="42"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <TextBlock Text="Регистрация"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#263238"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО"
                           Foreground="#546E7A"
                           Margin="4,0,0,6"/>

                <TextBox x:Name="NameBox"
                         Height="42"
                         Padding="10"
                         Margin="0,0,0,12"
                         BorderBrush="#CFD8DC"
                         Background="#F8FAFA"/>

                <!-- EMAIL -->
                <TextBlock Text="Email"
                           Foreground="#546E7A"
                           Margin="4,0,0,6"/>

                <TextBox x:Name="EmailBox"
                         Height="42"
                         Padding="10"
                         Margin="0,0,0,12"
                         BorderBrush="#CFD8DC"
                         Background="#F8FAFA"/>

                <!-- ТЕЛЕФОН -->
                <TextBlock Text="Телефон"
                           Foreground="#546E7A"
                           Margin="4,0,0,6"/>

                <TextBox x:Name="PhoneBox"
                         Height="42"
                         Padding="10"
                         Margin="0,0,0,12"
                         BorderBrush="#CFD8DC"
                         Background="#F8FAFA"/>

                <!-- ЛОГИН -->
                <TextBlock Text="Логин"
                           Foreground="#546E7A"
                           Margin="4,0,0,6"/>

                <TextBox x:Name="LoginBox"
                         Height="42"
                         Padding="10"
                         Margin="0,0,0,12"
                         BorderBrush="#CFD8DC"
                         Background="#F8FAFA"/>

                <!-- ПАРОЛЬ -->
                <TextBlock Text="Пароль"
                           Foreground="#546E7A"
                           Margin="4,0,0,6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             Padding="10"
                             Margin="0,0,0,25"
                             BorderBrush="#CFD8DC"
                             Background="#F8FAFA"/>

                <!-- КНОПКА РЕГИСТРАЦИИ -->
                <Button Content="Зарегистрироваться"
                        Height="46"
                        Background="#1B7A38"
                        Style="{StaticResource RoundedButton}"
                        Click="Register_Click"/>

                <!-- КНОПКА НАЗАД -->
                <Button Content="Назад"
                        Height="46"
                        Background="#ECEFF1"
                        Foreground="#455A64"
                        Style="{StaticResource RoundedButton}"
                        Margin="0,12,0,0"
                        Click="Back_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>