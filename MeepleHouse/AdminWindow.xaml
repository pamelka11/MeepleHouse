<Window x:Class="MeepleHouse.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeple House"
        Height="796"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9F8"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="ProfileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B6B32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="27">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                  ShadowDepth="4"
                                                  Opacity="0.25"/>
                            </Border.Effect>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="👤"
                                           FontSize="20"
                                           Margin="0 0 10 0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#1B6B32"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0 0 0 12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Width="220"
                                Height="58"
                                Background="#F1F8F3"
                                CornerRadius="16"
                                Padding="18 0"
                                HorizontalAlignment="Stretch">

                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1B6B32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E5F3E8"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1B6B32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18 0"/>
            <Setter Property="Background" Value="#1B6B32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8 0 0 0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#455A64"/>
        </Style>

        <Style x:Key="AdminDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF2EF"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="260"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E3B22" Offset="0"/>
                    <GradientStop Color="#0F6B2C" Offset="0.55"/>
                    <GradientStop Color="#167A35" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <TextBlock Text="🎲  🎴  ♟  🎯  🧩  🎲"
                       FontSize="54"
                       Opacity="0.08"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0 25 60 0"/>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="70 0 0 15">

                <Border Width="110"
                        Height="110"
                        CornerRadius="28"
                        BorderBrush="White"
                        BorderThickness="5"
                        Margin="0 0 35 0">

                    <TextBlock Text="♟"
                               FontSize="62"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Meeple House"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Панель администратора"
                               FontSize="22"
                               Foreground="#B9DEB5"
                               Margin="4 5 0 0"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0 14 0 0">
                        <Rectangle Width="120"
                                   Height="2"
                                   Fill="#7FCB7A"
                                   Margin="0 12 22 0"/>

                        <TextBlock Text="🎲"
                                   FontSize="24"
                                   Foreground="#8DD681"/>

                        <Rectangle Width="120"
                                   Height="2"
                                   Fill="#7FCB7A"
                                   Margin="22 12 0 0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button Content="Профиль"
                    Style="{StaticResource ProfileButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0 0 70 10"
                    Click="Profile_Click"/>
        </Grid>

        <!-- АДМИН-ПАНЕЛЬ -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="22"
                Margin="35,28,35,10"
                Padding="26">

            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="3"
                                  Opacity="0.14"/>
            </Border.Effect>

            <TabControl TabStripPlacement="Left"
                        BorderThickness="0"
                        Background="Transparent">

                <!-- ПОЛЬЗОВАТЕЛИ -->
                <TabItem Header="Пользователи"
                         Style="{StaticResource AdminTabItemStyle}" Margin="0,0,0,-5">

                    <Grid Margin="28 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E2E8E5"
                                BorderThickness="0 0 0 1"
                                Margin="0 0 0 18">

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Пользователи"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#263238"/>

                                    <TextBlock Text="Список зарегистрированных пользователей и их данные"
                                               FontSize="14"
                                               Foreground="#607D8B"
                                               Margin="0 4 0 0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <Button Content="Обновить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="RefreshUsers_Click"/>

                                    <Button Content="Удалить аккаунт"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteUser_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="UsersGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="160"/>
                                <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="190"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                                <DataGridTextColumn Header="Записан на игру" Binding="{Binding RegisteredGames}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- СОТРУДНИКИ -->
                <TabItem Header="Сотрудники"
                         Style="{StaticResource AdminTabItemStyle}" Margin="0,10,0,-13">

                    <Grid Margin="28 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E2E8E5"
                                BorderThickness="0 0 0 1"
                                Margin="0 0 0 18">

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Сотрудники"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#263238"/>

                                    <TextBlock Text="Управление работниками клуба"
                                               FontSize="14"
                                               Foreground="#607D8B"
                                               Margin="0 4 0 0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <Button Content="Добавить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="AddStaff_Click"/>

                                    <Button Content="Назначить на игру"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="AssignWorker_Click"/>

                                    <Button Content="Удалить"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteWorker_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="WorkersGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="190"/>
                                <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="220"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- АДМИНИСТРАТОРЫ -->
                <TabItem Header="Администраторы"
                         Style="{StaticResource AdminTabItemStyle}" Margin="0,23,0,-25">

                    <Grid Margin="28 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E2E8E5"
                                BorderThickness="0 0 0 1"
                                Margin="0 0 0 18">

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Администраторы"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#263238"/>

                                    <TextBlock Text="Список администраторов системы"
                                               FontSize="14"
                                               Foreground="#607D8B"
                                               Margin="0 4 0 0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <Button Content="Добавить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="AddStaff_Click"/>

                                    <Button Content="Удалить"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="DeleteAdmin_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="AdminsGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="190"/>
                                <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="220"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                                <DataGridTextColumn Header="Создал" Binding="{Binding CreatedBy}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ЖАЛОБЫ -->
                <TabItem Header="Жалобы"
                         Style="{StaticResource AdminTabItemStyle}" Margin="0,33,0,-34">

                    <Grid Margin="28 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E2E8E5"
                                BorderThickness="0 0 0 1"
                                Margin="0 0 0 18">

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Жалобы"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#263238"/>

                                    <TextBlock Text="Жалобы сотрудников на пользователей"
                                               FontSize="14"
                                               Foreground="#607D8B"
                                               Margin="0 4 0 0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <Button Content="Обновить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="RefreshComplaints_Click"/>

                                    <Button Content="Принять"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="AcceptComplaint_Click"/>

                                    <Button Content="Отклонить"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="RejectComplaint_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="ComplaintsGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="От кого" Binding="{Binding WorkerName}" Width="160"/>
                                <DataGridTextColumn Header="На кого" Binding="{Binding UserName}" Width="160"/>
                                <DataGridTextColumn Header="За что" Binding="{Binding ComplaintTitle}" Width="190"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding ComplaintText}" Width="*"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding ComplaintDate}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ЗАБЛОКИРОВАННЫЕ -->
                <TabItem Header="Заблокированные"
                         Style="{StaticResource AdminTabItemStyle}" Margin="0,45,0,-46">

                    <Grid Margin="28 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E2E8E5"
                                BorderThickness="0 0 0 1"
                                Margin="0 0 0 18">

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Заблокированные пользователи"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#263238"/>

                                    <TextBlock Text="Пользователи, которым временно запрещён вход в аккаунт"
                                               FontSize="14"
                                               Foreground="#607D8B"
                                               Margin="0 4 0 0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <Button Content="Обновить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="RefreshBlockedUsers_Click"/>

                                    <Button Content="Разблокировать"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="UnblockUser_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="BlockedUsersGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="170"/>
                                <DataGridTextColumn Header="Почта" Binding="{Binding Email}" Width="210"/>
                                <DataGridTextColumn Header="Заблокировал" Binding="{Binding AdminName}" Width="170"/>
                                <DataGridTextColumn Header="Причина" Binding="{Binding ComplaintTitle}" Width="180"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding ComplaintText}" Width="*"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding BlockedAt}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ИГРЫ -->
                <TabItem Header="Игры"
                         Style="{StaticResource AdminTabItemStyle}" Margin="0,53,0,-56">

                    <Grid Margin="28 0 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E2E8E5"
                                BorderThickness="0 0 0 1"
                                Margin="0 0 0 18">

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Игры"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#263238"/>

                                    <TextBlock Text="Редактирование игр и назначение сотрудников"
                                               FontSize="14"
                                               Foreground="#607D8B"
                                               Margin="0 4 0 0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">

                                    <Button Content="Обновить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="RefreshGames_Click"/>
                                    <Button Content="Сохранить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="SaveGames_Click" Width="130"/>

                                    <Button Content="Назначить"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="AssignWorker_Click" Width="130"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="GamesGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource AdminDataGridStyle}"
                                  Margin="0 0 0 14"
                                  IsReadOnly="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id"
                                                    Binding="{Binding Id}"
                                                    Width="60"
                                                    IsReadOnly="True"/>

                                <DataGridTextColumn Header="Название"
                                                    Binding="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Описание"
                                                    Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Мин. игроков"
                                                    Binding="{Binding MinPlayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="110"/>

                                <DataGridTextColumn Header="Макс. игроков"
                                                    Binding="{Binding MaxPlayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2"
                                   Text="Назначения сотрудников"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#263238"
                                   VerticalAlignment="Top"/>

                        <DataGrid x:Name="AssignmentsGrid"
                                  Grid.Row="2"
                                  Style="{StaticResource AdminDataGridStyle}" Margin="0,29,0,0" Grid.RowSpan="2">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Работник" Binding="{Binding WorkerName}" Width="190"/>
                                <DataGridTextColumn Header="Игра" Binding="{Binding GameTitle}" Width="190"/>
                                <DataGridTextColumn Header="Назначил" Binding="{Binding AdminName}" Width="190"/>
                                <DataGridTextColumn Header="Дата назначения" Binding="{Binding AssignedDate}" Width="170"/>
                                <DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Window>